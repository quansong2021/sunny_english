# Deploy scripts generate random secrets in .env on first start.
APP_PORT=4178
BIND_ADDRESS=0.0.0.0
APP_USERNAME=sunny
APP_PASSWORD=replace-with-a-random-password-at-least-12-characters
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
DB_PASSWORD=replace-with-a-third-random-password
COOKIE_SECURE=false
# Used only when running Node outside Docker:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sunny_english
DB_USER=sunny
